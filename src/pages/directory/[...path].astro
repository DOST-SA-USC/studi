---
import { fetchDirectory } from "@/pages/directory/utils/directoryServer.ts";
import DirectoryPage from "src/pages/directory/components/directory.astro";
import StarlightPage from "@astrojs/starlight/components/StarlightPage.astro";

const ROOT_ID = "1DmyPKyoE5mcnU37g2t4f7arC3y2eIyRo";

const directoryResult = await fetchDirectory(ROOT_ID);

const directory = directoryResult.entries;

const { path } = Astro.params;

const pathSegments = path ? path.split("/").filter(Boolean) : [];
---

<StarlightPage
  frontmatter={{
    title: "Directory",
    description: "This is where the notes directory is located",
    template: "splash",
  }}
>
  <DirectoryPage entries={directory} pathSegments={pathSegments} />
</StarlightPage>
