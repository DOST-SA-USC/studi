---
import type { Directory } from "@/pages/directory/types/directory";
import { buildDirectoryContext } from "@/pages/directory/utils/directoryNavigation";
import { fetchDirectory } from "@/pages/directory/utils/directoryServer.ts";

interface Props {
  entries?: Directory;
  pathSegments: string[];
}

const { entries = [], pathSegments } = Astro.props;
const BASE_URL = "/directory";

// ==== SIDEBAR ITEMS (Programs) ====
const sidebarItems = entries;
const activeProgramId = pathSegments[0];

// ==== NAVBAR ITEMS (Courses) ====
const activeProgram = entries.find((p) => p.id === activeProgramId);
const navbarResult = activeProgram
  ? await fetchDirectory(activeProgramId)
  : { entries: [], errorMessage: undefined };
const navbarItems = navbarResult.entries;
const activeCourseId = pathSegments[1];

// ==== GRID ITEMS ====
const context = await buildDirectoryContext(pathSegments);
const showGridContent = pathSegments.length >= 2;

// ==== HELPER FUNCTION ====
const getIconSrc = (type: string) => {
  const icons: Record<string, string> = {
    folder: "/directory-icons/primary-folder.svg",
    file: "/directory-icons/primary-file.svg",
    pdf: "/directory-icons/primary-file.svg",
    default: "/directory-icons/primary-unknown.svg",
  };
  return icons[type] || icons.default;
};
---

<div class="directory-container">
  <div class="subfolder-content">
    <div id="sidebar-overlay" class="sidebar-overlay"></div>
    <div class="sidebar-column bg-lightmode-body dark:bg-body">
      <div class="sidebar-scroll-wrapper">
        <div class="sidebar-header">
          <span class="sidebar-title"> Programs </span>
        </div>
        <div id="sidebar-target" class="sidebar-content">
          {
            sidebarItems.length > 0 ? (
              sidebarItems.map((item) => (
                <a
                  href={`${BASE_URL}/${item.id}`}
                  class:list={[
                    "sidebar-tab nav-item",
                    { active: item.id === activeProgramId },
                  ]}
                >
                  <div class="sidebar-tab-title">{item.name}</div>
                </a>
              ))
            ) : (
              <div class="status-msg empty-msg">No programs available.</div>
            )
          }
        </div>
      </div>
    </div>

    <div class="file-window bg-lightmode-dark dark:bg-dark">
      <div class="navbar-container">
        <a id="toggle-sidebar-btn" class="sidebar-toggle">
          <img src="/directory-icons/primary-menu.svg" alt="MENU" />
        </a>
        <div id="navbar-target" class="navbar-scroll-wrapper">
          {
            navbarItems.map((item) => {
              const currentId =
                item.type === "shortcut" ? item.targetId : item.id;

              return (
                <a
                  href={`${BASE_URL}/${activeProgramId}/${currentId}`}
                  class:list={[
                    "navbar-tab nav-item",
                    { active: currentId === activeCourseId },
                  ]}
                >
                  <div class="navbar-tab-title">{item.name}</div>
                </a>
              );
            })
          }
        </div>
      </div>
      <div class="folder-header">
        <a id="history-back" class="undo-redo-btn">
          <img src="/directory-icons/primary-undo.svg" alt="Back" />
        </a>
        <a id="history-forward" class="undo-redo-btn">
          <img src="/directory-icons/primary-redo.svg" alt="Back" />
        </a>

        <div
          class="breadcrumb-container"
          data-crumbs={JSON.stringify(context.breadcrumbs)}
        >
          {
            context.breadcrumbs.map((crumb) => (
              <>
                <span class="crumb-separator">›</span>
                <a
                  href={crumb.href}
                  class="breadcrumb-link nav-item"
                  data-label={crumb.label}
                >
                  {crumb.label}
                </a>
              </>
            ))
          }
        </div>
      </div>

      <div class="card-grid">
        {
          showGridContent ? (
            context.entries.length > 0 ? (
              context.entries.map((item) => {
                return (
                  <a
                    href={item.href}
                    class="Item-card nav-item"
                    data-type={item.type}
                    target="_blank"
                    rel="noopener noreferrer"
                  >
                    <img
                      src={getIconSrc(item.type)}
                      class="Item-icon"
                      alt={item.type}
                    />
                    <span class="Item-name">{item.name}</span>
                  </a>
                );
              })
            ) : (
              <div class="status-msg empty-msg-grid">
                {context.errorMessage || "This folder is empty."}
              </div>
            )
          ) : (
            <div class="status-msg empty-msg-grid prompt">
              {activeProgram
                ? "Select a course from the tabs above to view its contents."
                : "Select a program from the sidebar to get started."}
            </div>
          )
        }
      </div>
    </div>
  </div>
</div>

<script>
  type BreadcrumbType = {
    label: string;
    href: string;
  };

  const btn = document.getElementById("toggle-sidebar-btn");
  const sidebar = document.querySelector(".sidebar-column");

  const overlay = document.getElementById("sidebar-overlay");

  const toggleSidebar = () => {
    sidebar?.classList.toggle("active");
    overlay?.classList.toggle("active");
  };

  btn?.addEventListener("click", toggleSidebar);
  overlay?.addEventListener("click", toggleSidebar);

  const backBtn = document.getElementById("history-back");
  const fwdBtn = document.getElementById("history-forward");

  backBtn?.addEventListener("click", () => {
    window.history.back();
  });

  fwdBtn?.addEventListener("click", () => {
    window.history.forward();
  });

  const cardGrid = document.querySelector(".card-grid");
  const sidebarTarget = document.getElementById("sidebar-target");

  const gridWidths = [40, 20, 30, 20, 40, 50];
  const sidebarWidths = [70, 50, 80, 60, 70];

  const gridSkeletonHTML = gridWidths
    .map(
      (width) => `
    <a class="Item-card" style="pointer-events: none;">
      <div class="Item-icon skeleton"></div>
      <div class="Item-name skeleton-text" style="width: ${width}%; margin: 0;"></div>
    </a>
  `,
    )
    .join("");

  const sidebarSkeletonHTML = sidebarWidths
    .map(
      (width) => `
    <div class="sidebar-tab" style="pointer-events: none;">
      <div class="sidebar-tab-title skeleton-text" style="width: ${width}%; margin: 0;"></div>
    </div>
  `,
    )
    .join("");

  const navbarTabs = document.querySelectorAll(".navbar-tab");
  navbarTabs.forEach((tab) => {
    tab.addEventListener("click", () => {
      if (sidebarTarget) sidebarTarget.innerHTML = sidebarSkeletonHTML;
      if (cardGrid) cardGrid.innerHTML = gridSkeletonHTML;
    });
  });

  const otherNavItems = document.querySelectorAll(".sidebar-tab, .Item-card");
  otherNavItems.forEach((item) => {
    item.addEventListener("click", () => {
      if (item.getAttribute("data-type") === "file") return;
      if (cardGrid) {
        cardGrid.innerHTML = gridSkeletonHTML;
      }
    });
  });

  const getMaxLabelLength = (): number => {
    if (window.innerWidth < 600) {
      const mobileCrumbs = truncateBreadcrumbs(all, 2);
      const totalChars = mobileCrumbs.reduce(
        (sum: number, crumb: BreadcrumbType) => sum + crumb.label.length,
        0,
      );
      const charsPerPixel = totalChars / container.offsetWidth;
      if (charsPerPixel < 0.1) return Infinity;
      if (charsPerPixel < 0.2) return 10;
      return 10;
    }
    const totalChars = all.reduce(
      (sum: number, crumb: BreadcrumbType) => sum + crumb.label.length,
      0,
    );
    const charsPerPixel = totalChars / container.offsetWidth;
    if (charsPerPixel < 0.1) return Infinity;
    if (charsPerPixel < 0.2) return 40;
    if (charsPerPixel < 0.3) return 30;
    return 20;
  };

  const middleTruncate = (label: string, maxLength: number): string => {
    if (maxLength === Infinity || label.length <= maxLength) return label;
    const half = Math.floor((maxLength - 1) / 2);
    return label.slice(0, half) + "…" + label.slice(-half);
  };

  const truncateBreadcrumbs = (
    breadcrumbs: BreadcrumbType[],
    maxVisible: number,
  ) => {
    if (breadcrumbs.length <= maxVisible) return breadcrumbs;
    if (maxVisible === 2) {
      return [
        breadcrumbs[0],
        { label: "…", href: "" },
        breadcrumbs[breadcrumbs.length - 1],
      ];
    }
    return [
      breadcrumbs[0],
      { label: "…", href: "" },
      ...breadcrumbs.slice(-(maxVisible - 2)),
    ];
  };

  const container = document.querySelector(
    ".breadcrumb-container",
  ) as HTMLElement;
  const all = JSON.parse(container.dataset.crumbs ?? "[]") as BreadcrumbType[];

  const render = (crumbs: BreadcrumbType[]) => {
    const maxLength = getMaxLabelLength();
    container.innerHTML = crumbs
      .map((crumb: BreadcrumbType) =>
        crumb.href
          ? `<span class="crumb-separator">›</span><a href="${crumb.href}" class="breadcrumb-link nav-item" title="${crumb.label}">${middleTruncate(crumb.label, maxLength)}</a>`
          : `<span class="crumb-separator">›</span><span>…</span>`,
      )
      .join("");
  };
  const update = () => {
    const max = window.innerWidth < 700 ? 2 : 4;
    render(truncateBreadcrumbs(all, max));
  };

  update();
  window.addEventListener("resize", update);
</script>

<style is:global>
  .skeleton {
    background: linear-gradient(
      90deg,
      var(--sl-color-gray-5) 25%,
      var(--sl-color-gray-4) 50%,
      var(--sl-color-gray-5) 75%
    );
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite ease-in-out;
  }

  .skeleton-text {
    background: linear-gradient(
      90deg,
      var(--sl-color-gray-5) 25%,
      var(--sl-color-gray-4) 50%,
      var(--sl-color-gray-5) 75%
    );
    background-size: 200% 100%;
    width: 75%;
    height: 0.5rem;
    border-radius: 0.125rem;
    animation: shimmer 1.5s infinite ease-in-out;
  }

  @keyframes shimmer {
    0% {
      background-position: 200% 0;
    }
    100% {
      background-position: -200% 0;
    }
  }

  /* Card grid fade transition */
  .card-grid {
    transition: opacity 0.2s ease;
  }
  .card-grid.loading {
    opacity: 0.5;
  }

  .nav-item {
    cursor: pointer;
  }

  .directory-container {
    display: flex;
    flex-direction: column;
    width: 100%;
    height: 100%;
  }

  .subfolder-content {
    border-radius: 6px;
    display: flex;
    position: relative;
    overflow: hidden;
    width: 100%;
    min-height: 600px;
  }

  .file-window {
    flex-grow: 1;
    margin: 0;
    overflow: hidden;
    border-radius: 12px;
    padding: 2px;
  }

  .folder-header {
    width: 100%;
    padding: 1rem;
    font-weight: 600;
    font-size: 0.9rem;
    display: flex;
    align-items: center;
    justify-content: flex-start;
    gap: 1rem;
  }

  .undo-redo-btn {
    display: flex;
    justify-content: center;
    align-items: center;
    cursor: pointer;
    border-radius: 1rem;
    text-decoration: none;
    min-width: 30px;
    min-height: 30px;
  }

  .undo-redo-btn:hover {
    background-color: rgba(102, 115, 188, 0.1);
  }

  .breadcrumb-container {
    border-radius: 6px;
    flex-grow: 1;
    min-height: 30px;
    background-color: rgba(102, 115, 188, 0.1);
    padding: 10px;
  }

  .crumb-separator {
    margin: 0 0.35rem;
    color: var(--sl-color-gray-3);
    font-weight: 400;
  }

  .breadcrumb-link {
    text-decoration: none;
  }

  /* ==== GRID ==== */
  @layer starlight.components {
    .card-grid {
      display: grid;
      grid-template-columns: 1fr;
      padding-inline: 1rem;
    }

    .card-grid > :global(*) {
      margin-top: 0 !important;
    }
  }

  /* ==== NAVBAR ==== */
  .navbar-container {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    max-height: fit-content;
    min-height: 50px;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  .navbar-scroll-wrapper {
    display: flex;
    overflow-x: auto;
    width: 100%;
    scrollbar-width: none;
    mask-image: linear-gradient(
      to right,
      transparent,
      black 2rem,
      black calc(100% - 2rem),
      transparent
    );
    -webkit-mask-image: linear-gradient(
      to right,
      transparent,
      black 2rem,
      black calc(100% - 2rem),
      transparent
    );
  }

  .navbar-scroll-wrapper::-webkit-scrollbar {
    display: none;
  }

  .navbar-tab {
    min-width: 120px;
    display: block;
    padding: 1rem;
    text-decoration: none;
    overflow: hidden;
    transition:
      background-color 0.2s ease-in-out,
      color 0.2s ease-in-out;
    white-space: nowrap;
    border-radius: 2px;
    margin-bottom: 5px;
    position: relative;
  }

  .navbar-tab::after {
    content: "";
    position: absolute;
    bottom: 0;
    left: 0;
    right: 0;
    height: 3px;
    background-color: #6673bc;
    transform: scaleX(0);
    transition: transform 0.2s ease-in-out;
  }

  .navbar-tab-title {
    font-size: 0.8rem;
    line-height: 1.2;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    text-overflow: ellipsis;
    overflow: hidden;
    text-align: center;
    transition: color 0.2s ease;
  }

  .navbar-tab:hover .navbar-tab-title {
    color: #6673bc;
  }

  .navbar-tab:hover,
  .navbar-tab.active {
    background-color: rgba(102, 115, 188, 0.1);
  }

  .navbar-tab:hover::after,
  .navbar-tab.active::after {
    transform: scaleX(1);
  }

  /* ==== SIDEBAR ==== */
  .sidebar-column {
    width: 300px;
    display: flex;
    flex-direction: column;
    gap: 3px;
    height: 100%;
    flex-shrink: 0;
  }

  .sidebar-scroll-wrapper {
    height: 100%;
    overflow-y: auto;
    padding: 1.5rem;
  }

  .sidebar-header {
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--sl-color-hairline-light);
    font-weight: 600;
  }

  .sidebar-toggle {
    cursor: pointer;
    padding: 4px 8px;
    margin-right: 10px;
    border-radius: 4px;
    display: none;
    text-decoration: none;
  }

  .sidebar-toggle:hover {
    background-color: rgba(102, 115, 188, 0.1);
  }

  .sidebar-tab {
    display: flex;
    width: 100%;
    align-items: center;
    border-radius: 0.7rem;
    padding: 0.75rem 1rem;
    box-sizing: border-box;
    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .sidebar-tab-title {
    font-size: 0.9rem;
    line-height: 1.4;
    font-weight: 500;
    color: var(--sl-color-gray-2);
    word-break: break-word;
  }

  .sidebar-tab:hover {
    background-color: rgba(102, 115, 188, 0.1);
  }

  .sidebar-tab.active {
    background-color: rgba(102, 115, 188, 0.1);
    border-left: 3px solid #6673bc;
    padding-left: calc(1rem - 3px);
  }

  .sidebar-overlay {
    display: none;
  }

  @media (max-width: 1150px) {
    .sidebar-column {
      position: absolute;
      transform: translateX(-100%);
      transition: transform 0.2s ease-in-out;
      border-right: 1px solid var(--sl-color-gray-5);
      z-index: 11;
    }

    .sidebar-column.active {
      transform: translateX(0);
    }

    .sidebar-toggle {
      display: block;
    }

    .sidebar-overlay {
      display: block;
      position: absolute;
      inset: 0;
      background-color: rgba(0, 0, 0, 0.4);
      z-index: 10;
      opacity: 0;
      pointer-events: none;
      transition: opacity 0.2s ease-in-out;
    }

    .sidebar-overlay.active {
      opacity: 1;
      pointer-events: auto;
    }
  }

  /* ==== GRID ITEMS ==== */
  .Item-card {
    display: flex;
    justify-content: start;
    align-items: center;
    transition: all 0.2s ease;
    gap: 0.9rem;
    width: 100%;
    padding: 1rem 0;
    text-decoration: none;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .Item-icon {
    width: 24px;
    height: 24px;
    border-radius: 0.125rem;
    object-fit: contain;
  }

  .Item-content {
    text-align: left;
  }

  .Item-name {
    font-size: 0.8rem;
    line-height: 1.2;
    font-weight: 500;
  }

  .Item-card:hover {
    background-color: rgba(102, 115, 188, 0.05);
    padding-left: 0.5rem;
  }

  .status-msg {
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    width: 100%;
    color: var(--sl-color-gray-3);
    font-size: 0.9rem;
    font-style: italic;
  }

  #empty-msg {
    padding: 1.5rem;
    margin: 0.5rem;
    min-height: 200px;
  }

  #empty-msg-grid {
    grid-column: 1 / -1;
    padding: 3rem;
    margin: 1rem 0;
    min-height: 300px;
  }

  @media (max-width: 768px) {
    .sl-container,
    .content-panel,
    .sl-markdown-content {
      padding-inline: 0.2rem !important;
      margin-inline: 0 !important;
    }

    .directory-container {
      padding: 0;
    }

    .file-window {
      padding: 0;
      border-radius: 0;
    }

    .card-grid {
      padding-inline: 1rem;
    }

    .content-panel {
      padding-block-end: 0rem !important;
    }
  }
</style>
