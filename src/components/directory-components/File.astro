---
const { id, title } = Astro.props;
---

<a href="#" id={id} class="file-card">
  <div class="folder-icon-wrapper">
    <img src="src/assets/directory-icons/primary-file.svg" class="file-icon" />
  </div>

  <div class="file-content">
    <span class="file-name">
      {title}
    </span>
  </div>
</a>

<style>
  .file-card {
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    border-radius: 1rem;

    width: 140px;
    height: 150px;
    padding: 1rem;

    text-decoration: none;
  }

  .file-icon {
    width: 64px;
    height: 64px;
    object-fit: contain;
  }

  .file-content {
    text-align: center;
  }

  .file-name {
    font-size: 0.9rem;
    line-height: 1.2;
    font-weight: 500;
  }
</style>
