---
const { id, title, type } = Astro.props;

const icons: Record<string, string> = {
  folder: "/directory-icons/primary-folder.svg",
  file: "/directory-icons/primary-file.svg",
};

const iconSrc = icons[type];
---

<a href="#" id={id} class="folder-card" data-type={type}>
  <img src={iconSrc} class="folder-icon" alt={type} />

  <span class="folder-name">
    {title}
  </span>
</a>

<style>
  .folder-card {
    display: flex;
    justify-content: start;
    align-items: center;
    transition: all 0.2s ease;

    gap: 0.9rem;
    width: 100%;
    padding: 1rem;

    text-decoration: none;
    border-top: 1px solid var(--sl-color-gray-5);
  }

  .folder-icon {
    width: 24px;
    height: 24px;
    object-fit: contain;
  }

  .folder-content {
    text-align: left;
  }

  .folder-name {
    font-size: 0.8rem;
    line-height: 1.2;
    font-weight: 500;
  }

  .folder-card:hover {
    background-color: rgba(102, 115, 188, 0.05);
  }
</style>
