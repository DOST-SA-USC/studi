---
import Folder from "src/components/directory-components/Folder.astro";
import initialFolders from "src/components/directory-components/Folders.json";
import SidebarTab from "src/components/directory-components/SidebarTab.astro";
import NavbarTab from "src/components/directory-components/NavbarTab.astro";
---

<div class="directory-container">
  <!-- NAVBAR -->
  <div
    id="navbar-target"
    class="navbar-container bg-lightmode-body dark:bg-body"
  >
    <button id="toggle-sidebar-btn" class="sidebar-toggle">
      <!-- temporary icon, will be replaced -->
      ☰
    </button>
    {
      initialFolders.map((item: any) => {
        return <NavbarTab title={item.name} />;
      })
    }
  </div>
  <div class="subfolder-content">
    <div>
      <!-- SIDEBAR -->
      <div class="sidebar-column bg-lightmode-body dark:bg-body">
        <div class="sidebar-scroll-wrapper">
          <div class="sidebar-header">
            <span class="sidebar-title"> Programs </span>
          </div>
          <div id="sidebar-target" class="sidebar-content">
            {
              initialFolders.map((item: any) => {
                return <SidebarTab title={item.name} />;
              })
            }
          </div>
        </div>
      </div>
    </div>
    <div class="file-window bg-lightmode-dark dark:bg-dark">
      <div class="folder-header">
        <span style="margin-left: 10px;">BREADCRUMBS HERE</span>
      </div>
      <!-- GRID -->
      <div id="grid-target" class="card-grid" style={`--columns: 1`}>
        {
          initialFolders.map((item: any) => {
            return <Folder id={item.id} title={item.name} type={item.type} />;
          })
        }
      </div>
    </div>
  </div>
</div>

<script>
  // ==== SIDEBAR TOGGLE LOGIC ====
  const btn = document.getElementById("toggle-sidebar-btn");
  const sidebar = document.querySelector(".sidebar-column");

  btn?.addEventListener("click", () => {
    sidebar?.classList.toggle("active");
  });

  // ==== FETCHING LOGIC ====
  // const sidebarTarget = document.getElementById('sidebar-target');
  // const navbarTarget = document.getElementById('navbar-target');
  // const gridTarget = document.getElementById('grid-target');

  // const ROOT_ID = "1LBMK4Rd5jyJhg-e_lki-xLPL1LOvme1Y";
  // const API_KEY = import.meta.env.API_KEY;
  // const response = await fetch(`https://studi.dostsausc.org/api/${ROOT_ID}`, {
  //     headers: { 'Authorization': `Bearer ${API_KEY}` }
  // });
</script>

<style>
  .directory-container {
  }

  .subfolder-content {
    border-radius: 5px;
    display: flex;
    position: relative;
    overflow: hidden;
    width: 100%;
    min-height: 600px;
  }

  .file-window {
    flex-grow: 1;
    margin: 0;
    overflow: hidden;
  }

  .folder-header {
    width: 100%;
    padding: 10px;
    font-weight: 600;
    font-size: 0.9rem;

    display: flex;
    align-items: flex-start;
    justify-content: flex-start;
  }

  /* ==== GRID ==== */

  @layer starlight.components {
    .card-grid {
      display: grid;
      grid-template-columns: 1fr;
    }

    .card-grid > :global(*) {
      margin-top: 0 !important;
    }
  }

  /* ==== NAVBAR ==== */

  .navbar-container {
    display: flex;
    justify-content: flex-start;
    align-items: center;
    max-height: fit-content;
    border-bottom: 1px solid var(--sl-color-gray-5);
  }

  /* ==== SIDEBAR ==== */

  .sidebar-column {
    /* width: 300px; */
    display: flex;
    flex-direction: column;
    height: 100%;
    flex-shrink: 0;
  }

  .sidebar-scroll-wrapper {
    height: 100%;
    overflow-y: auto;
    padding: 1.5rem;
  }

  .sidebar-header {
    margin-bottom: 1rem;
    padding-bottom: 0.5rem;
    border-bottom: 1px solid var(--sl-color-hairline-light);
    font-weight: 600;
  }

  .sidebar-toggle {
    cursor: pointer;
    padding: 4px 8px;
    margin-right: 10px;
    border-radius: 4px;
    display: none;
  }

  @media (max-width: 1150px) {
    .sidebar-column {
      position: absolute;
      transform: translateX(-100%);
      transition: transform 0.2s ease-in-out;
      border-right: 1px solid var(--sl-color-gray-5);
    }

    .sidebar-column.active {
      transform: translateX(0);
    }

    .sidebar-toggle {
      display: block;
    }
  }
</style>
