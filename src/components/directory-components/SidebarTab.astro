---
const { id, title } = Astro.props;
---

<a href="#" class="sidebar-tab" data-id={id}>
  <div class="sidebar-title">
    {title}
  </div>
</a>

<style>
  .sidebar-tab {
    display: flex;
    width: 100%;
    align-items: center;
    border-radius: 0.7rem;

    padding: 0.75rem 1rem;
    box-sizing: border-box;

    text-decoration: none;
    transition: all 0.2s ease;
    cursor: pointer;
  }

  .sidebar-tab-title {
    font-size: 0.9rem;
    line-height: 1.4;
    font-weight: 500;

    color: var(--sl-color-gray-2);

    word-break: break-word;
  }

  .sidebar-tab:hover {
    background-color: rgba(102, 115, 188, 0.1);
  }
</style>
